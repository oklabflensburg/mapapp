{% extends 'base.html.twig' %}

{% block title %}Admin login{% endblock %}

{% block stylesheets %}
    {% include 'security/_auth_styles.html.twig' %}
{% endblock %}

{% block body %}
    <form class="auth-card" method="post" action="{{ path('app_login_form') }}">
        <h1>AccessApp Admin</h1>

        {% if error %}
            <p class="auth-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}

        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="{{ last_username }}" required autofocus>

        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Log in</button>
    </form>
{% endblock %}
