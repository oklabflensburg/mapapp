{# Shared layout for the node and node relation review screens: the
   form/preview split and the unapproved tags section. #}
<style>
    .node-edit-split {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .node-edit-split-form {
        flex: 1 1 50%;
        min-width: 0;
    }

    .node-edit-split-preview {
        flex: 1 1 50%;
        min-width: 0;
        position: sticky;
        top: 1rem;
    }

    .node-edit-split-preview iframe {
        width: 100%;
        height: calc(100vh - 12rem);
        min-height: 24rem;
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        background: var(--body-bg);
    }

    .node-custom-tags,
    .node-edit-unapproved-tags {
        margin-bottom: 1.5rem;
        padding: 1rem;
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
    }

    .node-custom-tags h2,
    .node-edit-unapproved-tags h2 {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .node-edit-unapproved-tags-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }

    .node-edit-unapproved-tags-header h2 {
        margin: 0;
    }

    .node-edit-unapproved-tags .no-unapproved-tags {
        margin: 0;
        color: var(--text-muted);
    }

    .unapproved-tag-key-group {
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        margin-bottom: 0.5rem;
        overflow: hidden;
    }

    .unapproved-tag-key-group summary {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        cursor: pointer;
        list-style: none;
        background: var(--body-bg);
    }

    .unapproved-tag-key-group summary::-webkit-details-marker {
        display: none;
    }

    .unapproved-tag-key-group summary::after {
        content: '';
        margin-left: auto;
        width: 0.4rem;
        height: 0.4rem;
        border-right: 2px solid var(--text-muted);
        border-bottom: 2px solid var(--text-muted);
        transform: rotate(45deg);
        transition: transform 0.15s ease-in-out;
    }

    .unapproved-tag-key-group[open] summary::after {
        transform: rotate(225deg);
    }

    .unapproved-tag-key-group .unapproved-tag-key {
        font-weight: 600;
    }

    .unapproved-tag-key-group .unapproved-tag-count {
        color: var(--text-muted);
    }

    .unapproved-tags-table {
        width: 100%;
        border-collapse: collapse;
    }

    .unapproved-tags-table th,
    .unapproved-tags-table td {
        text-align: left;
        padding: 0.375rem 0.5rem;
        border-bottom: 1px solid var(--border-color);
        vertical-align: middle;
    }

    .unapproved-tags-table th {
        color: var(--text-muted);
        font-weight: 600;
    }

    .unapproved-tags-table td:last-child,
    .unapproved-tags-table th:last-child {
        text-align: right;
    }

    .unapproved-tags-table td.observation-translations {
        text-align: left;
        overflow-wrap: anywhere;
        padding: 0.75rem 0.5rem;
    }

    .tag-review-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 5.5rem;
        gap: 0.5rem;
        align-items: start;
        margin-bottom: 0.5rem;
    }

    .tag-review-row > div {
        min-width: 0;
    }

    .tag-review-observations {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        font-size: 0.75rem;
    }

    .tag-review-observations strong {
        font-size: 1rem;
    }

    .tag-review-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

    /* Update-vs-add mapping for structured street-part observations. */
    .tag-review-mapping {
        grid-template-columns: 5.5rem minmax(0, 1fr) minmax(0, 1fr);
        margin-bottom: 0.5rem;
    }

    .tag-review-mapping span {
        font-size: 0.75rem;
    }

    .tag-review-mapping select {
        width: 100%;
        min-width: 0;
    }

    .approved-cross-section {
        margin-bottom: 1.5rem;
        padding: 1rem;
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
    }

    .approved-cross-section h2 {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .approved-cross-section table {
        width: 100%;
        border-collapse: collapse;
    }

    .approved-cross-section th,
    .approved-cross-section td {
        text-align: left;
        padding: 0.375rem 0.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .approved-cross-section th {
        color: var(--text-muted);
        font-weight: 600;
    }

    .observation-translations input[type="text"],
    .observation-translations textarea {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }

    .observation-translations label {
        display: block;
        font-size: 0.75rem;
    }

    .observation-translations button {
        margin: 0.25rem 0.25rem 0 0;
    }

    @media (max-width: 991px) {
        .node-edit-split {
            flex-direction: column;
        }

        .node-edit-split-preview iframe {
            height: 24rem;
        }
    }
</style>
