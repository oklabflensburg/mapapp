{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{% extends '@EasyAdmin/crud/edit.html.twig' %}

{# Pending relation observation review screen: the unapproved tags of a node
   relation with their approve actions, the relation members and the frontend
   preview centered on its first member. #}
{% block main %}
    {% set group = entity.instance %}
    {% set frontend_url = app_frontend_url|default('http://localhost:5173')|trim('/') %}
    {% set first_member = group.members|first %}
    {% set preview_src = frontend_url ~ '/?lat=' ~ (first_member ? first_member.node.latitude : 54.791) ~ '&lon=' ~ (first_member ? first_member.node.longitude : 9.437) ~ '&zoom=18' %}
    <div class="node-edit-split">
        <div class="node-edit-split-form">
            <section class="relation-review-summary">
                <h1>{{ group.name ?: 'Node relation #' ~ group.id }}</h1>
                <p class="relation-review-meta">
                    {{ group.members|length }} {{ group.members|length == 1 ? 'member' : 'members' }} ·
                    created by {{ group.createdByUser }}
                </p>
                <ul class="relation-review-members">
                    {% for member in group.members %}
                        <li>
                            <a href="{{ path('app_admin_node_edit', {entityId: member.node.id}) }}">{{ member.node.providerNodeId }}</a>
                            <small>{{ member.node.nodeProvider.name }}</small>
                        </li>
                    {% endfor %}
                </ul>
            </section>
            {% if approved_cross_section is defined %}
                {# Structured street-part context for the update-vs-add
                   decision on pending aspect observations. #}
                <section class="approved-cross-section">
                    <h2>Approved cross-section</h2>
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Element</th>
                                <th scope="col">Approved aspects</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for element in approved_cross_section %}
                                <tr>
                                    <td>{{ element.type }} {{ element.index }}</td>
                                    <td>
                                        {%- for aspect, value in element.aspects -%}
                                            {{ aspect }}={{ value }}{% if not loop.last %}, {% endif %}
                                        {%- endfor -%}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </section>
            {% endif %}
            {% if merge_candidates is defined and merge_candidates is not empty %}
                {# Overlapping relations: the admin decides whether to merge
                   (and which relation survives) while reviewing the pending
                   observation; competing tag keys must be resolved per row
                   (see specs/map-editing/relation-merge/spec.md). #}
                <section class="relation-merge">
                    <h2>Overlapping relations</h2>
                    {% for candidate in merge_candidates %}
                        <form method="post" action="{{ path('app_admin_node_group_merge', {id: group.id, candidateId: candidate.id}) }}" class="relation-merge-candidate">
                            <input type="hidden" name="_token" value="{{ csrf_token('merge_' ~ group.id ~ '_' ~ candidate.id) }}">
                            <input type="hidden" name="merge_snapshot" value="{{ candidate.snapshot }}">
                            <h3>{{ candidate.label }}</h3>
                            <p class="relation-merge-meta">
                                {{ candidate.memberCount }} {{ candidate.memberCount == 1 ? 'member' : 'members' }} ·
                                {{ candidate.approvedTags }}
                            </p>
                            <label class="relation-merge-target">
                                <span>Merge decision</span>
                                <select name="merge_target">
                                    <option value="candidate">Merge this relation into {{ candidate.label }} — the approved relation survives</option>
                                    <option value="reviewed">Merge {{ candidate.label }} into this relation — this relation survives</option>
                                </select>
                            </label>
                            {% if candidate.conflicts is not empty %}
                                <p>Both relations carry these tag keys; select the rows that survive the merge.</p>
                                {% for conflict in candidate.conflicts %}
                                    <fieldset class="relation-merge-conflict">
                                        <legend>{{ conflict.key }}</legend>
                                        {% for row in conflict.rows %}
                                            <label class="relation-merge-row">
                                                <input type="checkbox" name="merge_keep[]" value="{{ row.id }}"{% if row.checked %} checked{% endif %}>
                                                {{ (row.side == 'reviewed' ? 'this relation' : candidate.label) ~ ' · ' ~ row.value ~ ' by ' ~ row.user ~ (row.approved ? ' · approved' : ' · pending') }}
                                            </label>
                                        {% endfor %}
                                    </fieldset>
                                {% endfor %}
                            {% endif %}
                            <button class="btn btn-danger" type="submit">Merge relations</button>
                        </form>
                    {% endfor %}
                </section>
            {% endif %}
            {% include 'admin/_unapproved_tags.html.twig' with { tags: group.groupTags, next_url: path('app_admin_node_group_next_pending', {id: group.id}), empty_message: 'No unapproved tags on this relation.' } %}
        </div>
        <aside class="node-edit-split-preview">
            <iframe src="{{ preview_src }}" title="App frontend preview of this node relation" loading="lazy"></iframe>
        </aside>
    </div>

    {% include 'admin/_review_styles.html.twig' %}

    <style>
        .relation-review-summary {
            margin-bottom: 1.5rem;
            padding: 1rem;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
        }

        .relation-review-summary h1 {
            font-size: 1.25rem;
            margin: 0 0 0.5rem;
        }

        .relation-review-meta {
            margin: 0 0 0.75rem;
            color: var(--text-muted);
        }

        .relation-review-members {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .relation-review-members li {
            padding: 0.25rem 0;
            border-bottom: 1px solid var(--border-color);
        }

        .relation-review-members small {
            color: var(--text-muted);
        }

        .relation-merge h2 {
            font-size: 1.1rem;
        }

        .relation-merge-candidate {
            padding: 1rem;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
            margin-bottom: 1rem;
        }

        .relation-merge-candidate h3 {
            margin: 0 0 0.25rem;
            font-size: 1rem;
        }

        .relation-merge-meta {
            margin: 0 0 0.75rem;
            color: var(--text-muted);
        }

        .relation-merge-target,
        .relation-merge-row {
            display: block;
            margin-bottom: 0.5rem;
        }

        .relation-merge-conflict {
            margin: 0 0 0.75rem;
            padding: 0.5rem 0.75rem;
            border: 1px dashed var(--border-color);
            border-radius: var(--border-radius);
        }

        .relation-merge-conflict legend {
            font-weight: 600;
            padding: 0 0.25rem;
        }
    </style>
{% endblock %}
